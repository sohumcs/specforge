# Rendered at container start by the nginx image's envsubst step.
# ${API_UPSTREAM} defaults to api:8000 (compose / k8s service name).

server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 1m;

    include /etc/nginx/security-headers.conf;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/markdown;

    # Hashed build assets never change: cache for a year.
    location /assets/ {
        expires 1y;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Live job progress (Server-Sent Events): no buffering, long reads.
    location ~ ^/api/v1/jobs/[^/]+/events$ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        # The API sets these too; keep one copy (nginx adds them for every response).
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
    }

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
        # The API sets these too; keep one copy (nginx adds them for every response).
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
    }

    location ~ ^/(health|ready|openapi\.json)$ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        # Swagger UI loads its JS/CSS from a CDN: relax the CSP for this page only.
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://fastapi.tiangolo.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; frame-ancestors 'none'" always;
    }

    # Prometheus scrapes the API service directly inside the cluster; not public.
    location = /metrics { return 404; }

    # Liveness for the web container itself.
    location = /nginx-health { access_log off; return 200 "ok\n"; }

    # SPA: unknown paths render index.html, which must never be cached.
    location / {
        try_files $uri /index.html;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
}
