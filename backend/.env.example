# Copy to backend/.env for local runs. Never commit the real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://specforge:specforge@localhost:5433/specforge
REDIS_URL=redis://localhost:6380/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

# Phase 3 (LLM providers): create the keys yourself, put them only in .env / cluster secrets.
# GEMINI_API_KEY=
# GROQ_API_KEY=
