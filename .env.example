# Optional overrides for docker compose (copy to .env). Everything has a dev default.
# LLM API keys go in backend/.env (see backend/.env.example), never here and never in git.

# WEB_PORT=8080
# POSTGRES_PASSWORD=specforge
# JWT_SECRET=          # generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# LLM_PROVIDERS=["gemini","groq"]   # '["demo"]' = fully offline, deterministic
# GENERATE_LIMIT_PER_IP_HOUR=6
